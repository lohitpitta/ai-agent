# OSV API Configuration
OSV_API_URL=https://api.osv.dev/v1
OSV_TIMEOUT=30
OSV_MAX_RETRIES=3
OSV_RETRY_BACKOFF=1

# Database Configuration
DB_PATH=vulnerability_scanner.db

# Report Configuration
REPORT_OUTPUT_DIR=reports

# Strands Decider 2B Configuration
DECIDER_SERVER_URL=http://localhost:8000
DECIDER_TIMEOUT=30

# Amazon Bedrock Configuration
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS credentials via environment variables or IAM roles:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN (optional)

# GitHub Advisory API Configuration
GITHUB_TOKEN=your_github_personal_access_token
