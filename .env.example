# OSV API Configuration
OSV_API_URL=https://api.osv.dev/v1
OSV_TIMEOUT=30
OSV_MAX_RETRIES=3
OSV_RETRY_BACKOFF=1

# Database Configuration
DB_PATH=vulnerability_scanner.db

# Report Configuration
REPORT_OUTPUT_DIR=reports

# Strands Decider 2B Configuration
DECIDER_SERVER_URL=http://localhost:8000
DECIDER_TIMEOUT=30

# Amazon Bedrock Configuration
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=

# GitHub Advisory API Configuration
GITHUB_TOKEN=your_github_personal_access_token

# NVD (National Vulnerability Database) API Configuration
# Get your free API key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your_nvd_api_key_here
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_TIMEOUT=30
NVD_MAX_RETRIES=3
NVD_RETRY_BACKOFF=6
